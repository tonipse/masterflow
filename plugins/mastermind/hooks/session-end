#!/usr/bin/env bash
# SessionEnd hook wrapper for the mastermind plugin.
# With python3: session_end.py (vault commit, background push, session state for /mastermind:wrap last).
# Without python3: the plain vault commit of v2, so autonomous captures are never lost. Never fails the session.
DIR="${0%/*}"
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$DIR/session_end.py"
fi
VAULT="${MASTERMIND_VAULT:-$HOME/Mastermind}"
[ -d "$VAULT/.git" ] || exit 0
cd "$VAULT" || exit 0
[ -n "$(git status --porcelain 2>/dev/null)" ] || exit 0
PROJECT="${CLAUDE_PROJECT_DIR:-$PWD}"
PROJECT="${PROJECT##*/}"
git add -A >/dev/null 2>&1 && git commit -qm "auto: session end (${PROJECT})" >/dev/null 2>&1
exit 0
